    "quirk": {
      "name": "Linhas de Trajetória",
      "category": "Emissao",
      "pot": 2,
      "ctl": 6,
      "description": "Vê e materializa linhas luminosas de projeção. Linhas vermelhas antecipam ataques em frações de segundo, indicando direção e velocidade pela intensidade da cor. Linhas azuis mostram o percurso físico de objetos arremessados, incluindo ricochetes.",
      "limits": "Concentração mental elevada; muitas trajetórias simultâneas provocam fortes dores de cabeça. alcance de leitura de 20 m, dependente de visão, sem atravessar obstáculos opacos; mudanças de forças ou movimento atualizam a previsão; luz sem solidez, sem força adicional. Foco seguro em até 3 trajetórias; ampliar para 4-6 por uma rodada custa +1 EST e causa Quirk-dor (-2 INT/PER/CTL) até 1 minuto de repouso sem leitura; mais de 6 excede a capacidade inicial.",
      "moves": [
        {
          "name": "Linha de Vetor",
          "cost": 0,
          "effect": "Visualiza um arremesso e seus ricochetes possíveis; +2 em Pontaria quando houver tempo para alinhar a trajetória. Não aumenta dano nem dispensa teste sob risco."
        },
        {
          "name": "Alerta Vermelho",
          "cost": 1,
          "effect": "Vantagem em uma reação de esquiva contra ataque visível cuja trajetória foi lida; consome a reação normal, sem garantir sucesso."
        },
        {
          "name": "Mapa de Interceptação",
          "cost": 2,
          "effect": "Usa uma ação para projetar até 3 trajetórias visíveis para aliados e indicar uma abertura; concede vantagem ao próximo teste pertinente de Akira ou de um aliado antes do fim de seu próximo turno."
        }
      ]
    },
